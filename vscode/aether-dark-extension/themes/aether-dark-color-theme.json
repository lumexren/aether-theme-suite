  "semanticTokenColors": {
    "enumMember": "#10a6d4",
    "macro": "#d19a66",
    "variable.constant": "#d19a66",
    "variable.defaultLibrary": "#e5c07b",
    "property.declaration": "#f13460",
    "function.declaration": "#3c78ff",
    "method.declaration": "#6296ff",
    "type": "#e5c07b",
    "struct": "#e5c07b",
    "interface": "#e5c07b",
    "namespace": "#e5c07b",
    "parameter": "#abb2bf",
    "keyword": "#a673f5"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#5c6370",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Doc Comments",
      "scope": [
        "comment.block.documentation",
        "comment.line.documentation"
      ],
      "settings": {
        "foreground": "#707888",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#269e9c"
      }
    },
    {
      "name": "String Escape & Regexp",
      "scope": [
        "constant.character.escape",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#38c6f0"
      }
    },
    {
      "name": "Numbers & Constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "support.constant",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#d19a66"
      }
    },
    {
      "name": "Keywords & Storage",
      "scope": [
        "keyword",
        "keyword.control",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#a673f5"
      }
    },
    {
      "name": "Operators & Logical Keywords",
      "scope": [
        "keyword.operator",
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "#10a6d4"
      }
    },
    {
      "name": "Functions & Methods",
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function"
      ],
      "settings": {
        "foreground": "#3c78ff"
      }
    },
    {
      "name": "Classes, Types & Interfaces",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.other.inherited-class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#e5c07b"
      }
    },
    {
      "name": "Variables & Properties",
      "scope": [
        "variable",
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#abb2bf"
      }
    },
    {
      "name": "Properties, Fields & Language Variables",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "variable.language",
        "support.variable.property",
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#f13460"
      }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#abb2bf"
      }
    },
    {
      "name": "HTML/XML/JSX Attributes",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#d19a66"
      }
    },
    {
      "name": "CSS Properties & Values",
      "scope": [
        "support.type.property-name.css",
        "support.type.property-name.scss"
      ],
      "settings": {
        "foreground": "#10a6d4"
      }
    },
    {
      "name": "JSON / YAML / TOML Keys",
      "scope": [
        "support.type.property-name.json",
        "entity.name.tag.yaml",
        "keyword.key.toml"
      ],
      "settings": {
        "foreground": "#f13460"
      }
    },
    {
      "name": "Markdown Headings",
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#3c78ff",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Bold & Italic",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#d19a66",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#a673f5",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown Inline Code",
      "scope": [
        "markup.inline.raw"
      ],
      "settings": {
        "foreground": "#269e9c"
      }
    },
    {
      "name": "Punctuation & Brackets",
      "scope": [
        "punctuation.separator",
        "punctuation.terminator",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#8e96a5"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#ffffff",
        "background": "#f13460"
      }
    }
  ]
}
