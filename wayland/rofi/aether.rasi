/* Aether Dark — Rofi Theme */
* {
  bg:        #111216;
  bg-alt:    #16181d;
  bg-focus:  #1a1d24;
  border:    #262a33;
  fg:        #f4f4f4;
  fg-muted:  #8e96a5;
  accent:    #3c78ff;
  urgent:    #f13460;

  background-color: transparent;
  text-color: @fg;
  font: "Google Sans 11";
}

window {
  background-color: @bg;
  border: 1px solid;
  border-color: @border;
  border-radius: 12px;
  padding: 14px;
  width: 560px;
}

inputbar {
  background-color: @bg-alt;
  border: 1px solid;
  border-color: @accent;
  border-radius: 8px;
  padding: 10px 12px;
  margin: 0 0 10px 0;
  spacing: 8px;
  children: [prompt, entry];
}

prompt {
  text-color: @accent;
}

entry {
  placeholder-color: @fg-muted;
}

listview {
  lines: 8;
  spacing: 4px;
}

element {
  padding: 8px 10px;
  border-radius: 8px;
}

element normal.urgent,
element alternate.urgent {
  text-color: @urgent;
}

element selected.normal {
  background-color: @accent;
  text-color: #ffffff;
}
